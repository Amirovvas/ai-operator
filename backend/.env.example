# Скопируйте в .env и заполните своими значениями: cp .env.example .env
# Реальный .env в git не попадает (см. .gitignore).

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai-operator
DB_USER=postgres
DB_PASSWORD=

# JWT (access — 15m, refresh — 7d). Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (Gmail / Calendar / Drive) — Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google-callback

# Gemini (AI Chat) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SMTP (письма с кодом восстановления пароля, Gmail app password)
SMTP_USER=
SMTP_PASS=
